{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldforge.local/schemas/tileforge-lock-1.schema.json",
  "title": "TileForge dependency lock (format 1)",
  "description": "Pinned identity of the imported TileForge release package (docs/REPOSITORY_BOUNDARIES.md, Artifact-only dependency). Written only by the explicit import command; authoritative for package identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lockFormat",
    "provider",
    "generator",
    "manifestFormat",
    "theme",
    "sourceCommit",
    "projectSeed",
    "tileSize",
    "packageId",
    "packagePath",
    "strippedRoot",
    "fileCount",
    "totalBytes",
    "packageSha256",
    "manifestSha256",
    "contentSha256",
    "importedAt",
    "sourceLabel",
    "excluded"
  ],
  "properties": {
    "lockFormat": { "const": 1 },
    "provider": { "const": "TileForge" },
    "generator": { "type": "string", "minLength": 1 },
    "manifestFormat": { "type": "integer", "minimum": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": ["string", "null"] },
    "projectSeed": { "type": ["integer", "null"] },
    "tileSize": { "type": ["integer", "null"] },
    "packageId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "packagePath": { "type": "string", "pattern": "^fixtures/tileforge-packages/[a-z0-9._-]+$" },
    "strippedRoot": { "type": ["string", "null"] },
    "fileCount": { "type": "integer", "minimum": 1 },
    "totalBytes": { "type": "integer", "minimum": 1 },
    "packageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "importedAt": { "type": "string" },
    "sourceLabel": { "type": "string" },
    "excluded": { "type": "array", "items": { "type": "string" } }
  }
}
